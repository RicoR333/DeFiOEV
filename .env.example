# OEV Searcher Agent Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# SCAN SETTINGS
# =============================================================================

# How often to scan for opportunities (in milliseconds)
# Default: 60000 (60 seconds)
SCAN_INTERVAL_MS=60000

# Maximum number of positions to analyze per scan
# Higher = more comprehensive but slower
# Default: 200
MAX_POSITIONS=200

# =============================================================================
# LIQUIDATION SETTINGS
# =============================================================================

# Health factor threshold for "at risk" alerts
# Positions below this threshold are flagged as at-risk
# Default: 1.1 (10% buffer before liquidation)
HEALTH_THRESHOLD=1.1

# Expected liquidation bonus (as decimal)
# This is the discount liquidators receive
# Default: 0.05 (5%)
LIQUIDATION_BONUS=0.05

# Minimum profit to consider an opportunity (in USD)
# Ignores tiny opportunities that wouldn't be profitable after gas
# Default: 10
MIN_PROFIT_USD=10

# =============================================================================
# EXECUTION MODE
# =============================================================================

# Run continuously or single scan
# true = keep scanning, false = run once and exit
# Default: true
CONTINUOUS_MODE=true

# Maximum number of scans to run (0 = unlimited)
# Useful for testing or scheduled runs
# Default: 0
MAX_SCANS=0

# =============================================================================
# API KEYS (Optional - for production use)
# =============================================================================

# The Graph API Key (optional - public endpoint works for demo)
# Get one at: https://thegraph.com/studio/
# GRAPH_API_KEY=your_api_key_here

# CoinGecko Pro API Key (optional - public endpoint works for demo)
# Get one at: https://www.coingecko.com/en/api/pricing
# COINGECKO_API_KEY=your_api_key_here

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Log level: DEBUG, INFO, WARN, ERROR
# Default: INFO
LOG_LEVEL=INFO

# Base RPC URL (for future on-chain interactions)
# BASE_RPC_URL=https://mainnet.base.org
